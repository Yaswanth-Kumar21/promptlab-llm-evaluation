# ─────────────────────────────────────────────────────────────────────────────
# PromptLab — Environment Variables
# Copy this file to .env and fill in the values you need.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_SECRET_KEY=change-me-to-a-random-secret-string
LOG_LEVEL=INFO

# ── Backend server ────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for local development — no setup required)
DATABASE_URL=sqlite:///./promptlab.db

# PostgreSQL (uncomment and fill in when ready for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/promptlab

# ── LLM Providers ─────────────────────────────────────────────────────────────
# Leave blank if you don't have the key — the provider will show as "not configured"

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-haiku-20240307

GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

MISTRAL_API_KEY=
MISTRAL_DEFAULT_MODEL=mistral-small-latest

# ── Default provider used when none is specified ──────────────────────────────
# Options: openai | anthropic | gemini | mistral | mock
DEFAULT_PROVIDER=mock

# ── Embeddings ────────────────────────────────────────────────────────────────
# Model used to create embeddings for RAG
# "local" uses a small sentence-transformers model (no API key needed)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data

# ── File uploads ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./rag/documents

# ── Rate limiting (requests per minute per IP) ────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
